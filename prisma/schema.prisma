generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttendanceStatus {
  ATTENDING
  DECLINED
  UNDECIDED
}

enum GuestCategory {
  FAMILY
  FRIENDS
  COLLEAGUES
  VIP
  OTHER
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role         @default(CUSTOMER)
  status        UserStatus   @default(ACTIVE)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders        Order[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
}

model Package {
  id                    String   @id @default(cuid())
  code                  String   @unique // BASIC, PREMIUM, EXCLUSIVE
  name                  String
  price                 Int      // in IDR
  originalPrice         Int?     // strike-through price
  description           String
  features              String   // JSON string of feature bullet points
  maxGuests             Int      @default(200)
  maxEvents             Int      @default(2)
  maxPhotos             Int      @default(10)
  allowsMusic           Boolean  @default(true)
  allowsDigitalEnvelope Boolean  @default(true)
  allowsQris            Boolean  @default(false)
  allowsCustomDomain    Boolean  @default(false)
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orders                Order[]
}

model Order {
  id            String       @id @default(cuid())
  orderNumber   String       @unique // e.g. NUA-2026-0001
  userId        String
  packageId     String
  amount        Int
  status        OrderStatus  @default(PENDING)
  customerNotes String?
  adminNotes    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package       Package      @relation(fields: [packageId], references: [id])
  payments      Payment[]
  invitations   Invitation[]

  @@index([userId])
  @@index([orderNumber])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  paymentMethod String        // BANK_TRANSFER, QRIS, MANUAL
  amount        Int
  proofImage    String?
  status        PaymentStatus @default(PENDING)
  bankSource    String?       // e.g. BCA, Mandiri
  accountNumber String?
  accountName   String?
  notes         String?
  verifiedAt    DateTime?
  verifiedBy    String?       // admin user id or email
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model TemplateCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  templates   Template[]
}

model Template {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  categoryId     String
  previewImage   String
  description    String
  tier           String           @default("BASIC") // BASIC, PREMIUM, EXCLUSIVE
  colorScheme    String           @default("classic") // classic, heritage, botanical, islamic
  isFeatured     Boolean          @default(false)
  isActive       Boolean          @default(true)
  defaultSections String?         // JSON
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  category       TemplateCategory @relation(fields: [categoryId], references: [id])
  invitations    Invitation[]

  @@index([slug])
  @@index([categoryId])
}

model Invitation {
  id                       String           @id @default(cuid())
  slug                     String           @unique // e.g. andi-ani
  userId                   String
  templateId               String
  orderId                  String?
  status                   InvitationStatus @default(DRAFT)
  
  // Couple Details
  brideName                String
  brideNickname            String
  brideParents             String
  brideInstagram           String?
  
  groomName                String
  groomNickname            String
  groomParents             String
  groomInstagram           String?

  quote                    String?
  quoteSource              String?
  story                    String?          // JSON array of love story milestones
  weddingDate              DateTime
  weddingTimezone          String           @default("WIB")
  primaryLocation          String
  coverImage               String?
  closingImage             String?
  closingMessage           String?
  weddingHashtag           String?

  // Media & Features
  musicUrl                 String?
  musicTitle               String?
  isMusicAutoPlay          Boolean          @default(true)
  isEnvelopeActive         Boolean          @default(true)
  isGuestbookActive        Boolean          @default(true)
  isRsvpActive             Boolean          @default(true)
  requireGuestbookModeration Boolean        @default(false)
  maxAttendeesPerGuest     Int              @default(2)
  themeStyle               String           @default("classic")

  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template                 Template         @relation(fields: [templateId], references: [id])
  order                    Order?           @relation(fields: [orderId], references: [id])
  
  events                   InvitationEvent[]
  galleries                InvitationGallery[]
  gifts                    InvitationGift[]
  guests                   Guest[]
  rsvps                    Rsvp[]
  guestbookMessages        GuestbookMessage[]
  views                    InvitationView[]

  @@index([slug])
  @@index([userId])
}

model InvitationEvent {
  id            String     @id @default(cuid())
  invitationId  String
  title         String     // Akad Nikah, Resepsi, Pemberkatan, etc.
  eventDate     DateTime
  startTime     String     // e.g. "09:00"
  endTime       String?    // e.g. "12:00" or "Selesai"
  timezone      String     @default("WIB")
  venueName     String
  address       String
  googleMapsUrl String?
  coverImage    String?
  sortOrder     Int        @default(0)

  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model InvitationGallery {
  id           String     @id @default(cuid())
  invitationId String
  imageUrl     String
  caption      String?
  sortOrder    Int        @default(0)
  isFeatured   Boolean    @default(false)

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model InvitationGift {
  id            String     @id @default(cuid())
  invitationId  String
  type          String     // BANK, EWALLET, QRIS
  providerName  String     // BCA, Mandiri, BRI, BNI, GoPay, OVO, QRIS
  accountName   String
  accountNumber String
  qrisImageUrl  String?
  notes         String?
  sortOrder     Int        @default(0)

  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model Guest {
  id           String            @id @default(cuid())
  invitationId String
  name         String
  category     GuestCategory     @default(FRIENDS)
  phone        String?
  email        String?
  maxAttendees Int               @default(2)
  isSent       Boolean           @default(false)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  invitation   Invitation        @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  token        GuestToken?
  rsvp         Rsvp?
  guestbook    GuestbookMessage[]
  views        InvitationView[]

  @@index([invitationId])
  @@index([name])
}

model GuestToken {
  id           String    @id @default(cuid())
  guestId      String    @unique
  token        String    @unique // High entropy cryptographically secure token
  lastOpenedAt DateTime?
  totalVisits  Int       @default(0)
  expiresAt    DateTime?
  isRevoked    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  guest        Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Rsvp {
  id               String           @id @default(cuid())
  invitationId     String
  guestId          String           @unique
  attendanceStatus AttendanceStatus
  attendeeCount    Int              @default(1)
  message          String?
  submittedAt      DateTime         @default(now())
  ipAddress        String?

  invitation       Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest            Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model GuestbookMessage {
  id           String     @id @default(cuid())
  invitationId String
  guestId      String?
  senderName   String
  message      String
  isApproved   Boolean    @default(true)
  isHidden     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest        Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId])
}

model InvitationView {
  id           String     @id @default(cuid())
  invitationId String
  guestId      String?
  ipAddress    String?
  userAgent    String?
  visitedAt    DateTime   @default(now())

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest        Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@index([guestId])
}

model Testimonial {
  id           String   @id @default(cuid())
  coupleNames  String
  weddingDate  String
  avatarUrl    String?
  rating       Int      @default(5)
  reviewText   String
  templateName String
  isFeatured   Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("Umum")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}
